# Copy to .env and fill in. For local dev, `supabase start` prints these
# (API URL and anon key). Demo login is seeded by supabase/seed.sql:
#   demo@structly.app / structly-demo-1
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Optional override. If omitted, Structly derives /functions/v1 from Supabase URL.
EXPO_PUBLIC_STRUCTLY_FUNCTIONS_URL=
