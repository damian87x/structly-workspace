{
  "expo": {
    "name": "Structly",
    "slug": "structly",
    "version": "0.1.0",
    "orientation": "portrait",
    "plugins": [
      [
        "expo-image-picker",
        {
          "cameraPermission": "Structly uses the camera to capture receipt photos.",
          "microphonePermission": false,
          "photosPermission": "Structly uses your photo library so you can choose receipt photos."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Structly uses your location while capturing a receipt to add the place to that receipt."
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Structly needs full calendar access to match receipt times to client meetings."
        }
      ]
    ],
    "scheme": "structly",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.structly.app",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "eas": {
        "projectId": "b4230adf-b908-4e3b-9ad0-3e57d5f6369e"
      }
    },
    "owner": "damian87x"
  }
}
